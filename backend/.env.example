# ローカル開発（Docker PostgreSQL）
DATABASE_URL=postgresql://postgres@db:5432/image_palace_development
TEST_DATABASE_URL=postgresql://postgres@db:5432/image_palace_test

# 本番（Neon）は Fly.io secrets で設定
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# アプリ設定
RAILS_ENV=development
RAILS_MAX_THREADS=5

# CORS（フロントエンドのURL・カンマ区切り。末尾スラッシュや空白を入れない）
# 本番: https://imagepalace.app
CORS_ORIGINS=http://localhost:3000

# フロントエンドURL。OAuthコールバックの戻り先、確認メールの戻り先、
# Stripe の success_url / cancel_url / Portal の return_url の基準になる
# 本番: https://imagepalace.app
FRONTEND_URL=http://localhost:3000

# バックエンド自身のURL。OmniAuth が組み立てる redirect_uri の基準になる
# 本番: https://api.imagepalace.app
BACKEND_URL=http://localhost:3001

# メールのリンクに使うホスト。**フロントではなく API のホスト**を入れる
# （確認リンクを処理するのは Rails。フロントを入れると 404 になる）
# 本番: api.imagepalace.app
APP_HOST=localhost:3001

# 認証
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# 画像生成
OPENAI_API_KEY=your_openai_api_key_here
IMAGE_GENERATION_PROVIDER=openai

# Cloudflare R2 ストレージ
# Fly.io secrets で設定。ローカルは Disk ストレージを使うため通常は不要
# 本番のバケットは image-palace-production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# CDN配信。設定すると画像URLが Rails 経由の redirect から CDN 直に切り替わる
# 本番: https://cdn.imagepalace.app（CSP の img-src に入っていることが前提）
CDN_BASE_URL=

# === Sign in with Apple ===
APPLE_CLIENT_ID=          # Services ID 例: com.imagepalace.signin
APPLE_TEAM_ID=            # Apple Developer の Team ID
APPLE_KEY_ID=             # Sign in with Apple 用キーの Key ID
APPLE_PRIVATE_KEY=        # .p8 の中身（改行は \n でエスケープ可）

# === Stripe ===
STRIPE_SECRET_KEY=        # sk_test_... （本番は sk_live_...）
STRIPE_WEBHOOK_SECRET=    # whsec_...（Webhook署名検証用・2-2で使用）
