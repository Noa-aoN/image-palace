# ローカル開発（Docker PostgreSQL）
DATABASE_URL=postgresql://postgres@db:5432/image_palace_development
TEST_DATABASE_URL=postgresql://postgres@db:5432/image_palace_test

# 本番（Neon）は Fly.io secrets で設定
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# アプリ設定
RAILS_ENV=development
RAILS_MAX_THREADS=5
APP_HOST=image-palace-api.fly.dev

# CORS（フロントエンドのURL）
CORS_ORIGINS=http://localhost:3000

# 画像生成
OPENAI_API_KEY=your_openai_api_key_here
IMAGE_GENERATION_PROVIDER=openai

# Cloudflare R2 ストレージ（本番・staging）
# Fly.io secrets で設定。ローカルはDiskストレージを使用するため不要
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# CDN配信（将来: CDN_BASE_URL=https://cdn.yourdomain.com を設定するだけで切り替わる）
CDN_BASE_URL=
