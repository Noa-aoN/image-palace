#!/usr/bin/env bash
# 本番へデプロイし、**全てのマシンが起動しているか**まで確かめる。
#
# fly deploy は http_service を持つ app のヘルスチェックしか見ない。worker には
# チェックが無いため、worker が停止したままでもデプロイは「成功」で終わる。
# 実際 2026-08-09 にそれが起き、ジョブが33件滞留した（カードが生成待ちで止まった）。
# しかもこれは一過性ではなく、デプロイのたびに起きている。
#
# standby（`standbys` を持つマシン）は停止しているのが正しい状態なので、対象から外す。
# standby はホストが物理的に壊れたときだけ引き継ぐもので、実働マシンが止まっても起動しない。
set -euo pipefail

APP="${FLY_APP:-image-palace-api}"
# 遷移中（replacing / starting など）が収まるのを待つ上限。
# デプロイ直後は replacing のことがあり、その状態では start できない
SETTLE_TIMEOUT=120
SETTLE_INTERVAL=5

# 実働マシンの「id 種別 状態」を1行ずつ出す（standby は除く）
list_active() {
  fly machine list -a "$APP" --json | python3 -c '
import json, sys

for m in json.load(sys.stdin):
    config = m.get("config", {})
    if config.get("standbys"):
        continue  # standby は停止が正しい状態
    group = config.get("metadata", {}).get("fly_process_group", "?")
    print("\t".join([m["id"], group, str(m.get("state"))]))
'
}

echo "==> デプロイ: $APP"
fly deploy --now -a "$APP"

echo "==> マシンの状態が落ち着くのを待つ"
waited=0
while [ "$waited" -lt "$SETTLE_TIMEOUT" ]; do
  transient=$(list_active | awk -F'\t' '$3 != "started" && $3 != "stopped"' || true)
  [ -z "$transient" ] && break
  echo "  遷移中: $(echo "$transient" | tr '\n' ' ')"
  sleep "$SETTLE_INTERVAL"
  waited=$((waited + SETTLE_INTERVAL))
done

echo "==> 停止しているマシンを確認"
stopped=$(list_active | awk -F'\t' '$3 == "stopped"' || true)

if [ -z "$stopped" ]; then
  fly status -a "$APP" | grep -E "PROCESS|app |worker " || true
  echo "==> 全てのマシンが起動しています"
  exit 0
fi

echo "!!! 停止しているマシンがあります:"
echo "$stopped"

echo "==> 起動します"
echo "$stopped" | while IFS=$'\t' read -r id group state; do
  [ -z "$id" ] && continue
  echo "  start $id ($group)"
  fly machine start "$id" -a "$APP"
done

echo "==> 起動後の状態"
fly status -a "$APP" | grep -E "PROCESS|app |worker " || true

# 最後にもう一度見て、まだ停止していれば失敗として返す（黙って通さない）
remaining=$(list_active | awk -F'\t' '$3 == "stopped"' || true)
if [ -n "$remaining" ]; then
  echo "!!! まだ停止しています:"
  echo "$remaining"
  exit 1
fi
