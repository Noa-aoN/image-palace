# フロントエンドの環境変数。
#
# ここに書けるのは NEXT_PUBLIC_* だけ。**これらはビルド時にクライアントの JS へ
# 静的に埋め込まれる**ので、ブラウザから丸見えになる。秘密情報は絶対に置かないこと
# （API キーの類はバックエンドの環境変数に置く）。
#
# ローカルは frontend/.env.local に、本番は frontend/.env.production に書く。

# バックエンド API のオリジン（末尾スラッシュなし）
# 本番: https://api.imagepalace.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# 画像 CDN のオリジン。next/image の許可ホストに使う
# 本番: https://cdn.imagepalace.app
NEXT_PUBLIC_CDN_BASE_URL=

# 正式サイト URL。canonical / og:url / sitemap / robots の基準になる
# 未設定だと src/lib/site.ts の既定（https://imagepalace.app）が使われる
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Apple のボタンを出すか（バックエンド側の鍵設定と揃えること）
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false

# 計測（未設定なら無効）
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
